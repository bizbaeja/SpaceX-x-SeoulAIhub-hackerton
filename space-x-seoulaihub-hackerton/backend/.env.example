PORT=4000

# AI_PROVIDER=gemini | mock  (생략 시 GEMINI_API_KEY가 있으면 gemini, 없으면 mock)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
GEMINI_TIMEOUT_MS=15000

# 청소년 채팅: 답장(스트리밍)과 내부 평가에 다른 모델을 써서 모델별 사용량 한도(429)를 분산
GEMINI_CHAT_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
GEMINI_ASSESS_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.6-flash
GEMINI_FIRST_TOKEN_TIMEOUT_MS=6000
GEMINI_ASSESS_TIMEOUT_MS=8000

# DATABASE_URL=postgresql://...   (Supabase 연결 문자열. 비워두면 로컬 PGlite 파일 DB 사용)
